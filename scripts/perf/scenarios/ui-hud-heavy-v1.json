{
  "schema_version": 3,
  "id": "ui-hud-heavy-v1",
  "description": "Repeatable UI, text, HUD attachment, and media composition workload.",
  "cache_mode": "warm",
  "capture": {"warmup_seconds": 30, "duration_seconds": 120, "repeats": 5, "poll_interval_seconds": 0.5},
  "settings": {
    "AutoTuneFPS": false,
    "RenderBenchmarkUIScale": 1.0,
    "RenderDeferred": true,
    "RenderFarClip": 128.0,
    "RenderGLContextCoreProfile": true,
    "RenderHiDPI": true,
    "RenderReflectionsEnabled": true,
    "RenderShadowDetail": 2,
    "RenderVSyncEnable": false,
    "RenderVolumeLODFactor": 1.0,
    "WindowHeight": 720,
    "WindowMaximized": false,
    "WindowWidth": 1280,
    "YieldTime": -1
  },
  "validity": {
    "asset_mode": "settled",
    "population_mode": "stable",
    "ui_mode": "controlled",
    "settle_seconds": 15,
    "max_camera_translation_m": 0.1,
    "max_camera_rotation_rad": 0.05,
    "max_agent_travel_m": 0.0,
    "max_visible_avatar_delta": 0,
    "max_active_object_delta": 0,
    "max_new_objects": 0,
    "max_sim_ping_ms": 600
  },
  "workload": {
    "operator_setup": "Open the recorded floater layout and HUD set; use deterministic local media or disable media consistently.",
    "camera": "Fixed world camera behind an unchanged UI and HUD layout.",
    "observations": ["open floaters", "visible text", "HUD attachments", "media playback state"],
    "invalid_if": ["floater layout changes", "HUD attachment set changes", "media state differs", "window loses focus", "graphics features differ"]
  }
}
