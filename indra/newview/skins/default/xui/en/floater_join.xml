<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 height="768"
 width="1024"
 layout="topleft"
 name="floater_join"
 single_instance="true"
 show_title="false"
 legacy_header_height="0"
 header_height="0"
 background_visible="false"
 can_resize="false"
 can_drag_on_left="false"
 can_minimize="false"
 can_close="false"
 positioning="centered"
 save_rect="false">
  <!-- web_browser is wrapped in a scroll container so it stays reachable via scrollbars if the viewer window is too small-->
  <scroll_container
   follows="all"
   left="0"
   top="0"
   right="-1"
   bottom="-1"
   name="join_scroll"
   opaque="false"
   border_visible="false"
   mouse_opaque="false">
    <panel
     follows="left|top"
     left="0"
     top="0"
     width="1024"
     height="768"
     name="web_panel"
     background_visible="false"
     mouse_opaque="false">
      <web_browser
       follows="all"
       left="0"
       top="0"
       right="-1"
       bottom="-1"
       name="join_browser"
       trusted_content="false"
       border_visible="false" />
    </panel>
  </scroll_container>
  <view_border
   follows="all"
   left="0"
   top="0"
   right="-1"
   bottom="-1"
   border_thickness="1"
   bevel_style="none"
   highlight_light_color="White"
   mouse_opaque="false"
   name="floater_outline" />
</floater>
