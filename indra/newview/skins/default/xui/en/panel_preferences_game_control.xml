<?xml version="1.0" encoding="utf-8"?>
<panel
    border="true"
    follows="all"
    height="408"
    label="Game Controls"
    layout="topleft"
    left="102"
    name="game_control_panel"
    top="1"
    width="517">
    <check_box
        name="game_control_enabled"
        label="Enable GameControl"
        layout="topleft"
        follows="top|left"
        height="16"
        width="200"
        top="8"
        left="10"
        tool_tip="Master switch: when off, no controller input drives actions and no GameControl data is sent to the server."/>
    <check_box
        name="game_control_to_server"
        label="Send GameControl Data to server"
        layout="topleft"
        follows="top|right"
        height="16"
        width="230"
        top="8"
        right="-10"/>
    <tab_container
        name="game_control_tabs"
        layout="topleft"
        follows="all"
        top="30"
        left="2"
        right="-2"
        bottom="-2">
        <!-- ACTIONS: global, per-mode.  Binds canonical inputs to logical actions. -->
        <panel
            name="tab_action_mappings"
            label="Action Mappings">
            <!-- Mode selector: one row per action mode.  Selecting a row chooses
                 which mode's mappings are edited below; the "Enabled" checkbox
                 toggles whether game-control input is converted to that mode's
                 actions (when off, the mode's mappings are locked). -->
            <panel
                name="action_mode_panel"
                layout="topleft"
                follows="top|left"
                top="6"
                left="1"
                width="234"
                height="72">
                <scroll_list
                    name="action_mode"
                    follows="all"
                    top="1"
                    left="1"
                    right="-1"
                    bottom="-1"
                    can_sort="false"
                    column_padding="0"
                    draw_heading="true"
                    multi_select="false"
                    selection_type="row"
                    tool_tip="Select a mode to edit its mappings.  Uncheck Enabled to lock a mode's mappings and stop converting game-control input to that mode's actions."
                    fg_disable_color="ScrollUnselectedColor">
                    <scroll_list.columns name="enabled" label="Enabled" type="checkbox" relative_width="0.3"/>
                    <scroll_list.columns name="mode"    label="Mode"    relative_width="0.7"/>
                </scroll_list>
            </panel>
            <button
                name="restore_actions_defaults"
                layout="topleft"
                follows="top|right"
                top="6"
                right="-8"
                height="23"
                width="140"
                label="Restore Defaults"
                tool_tip="Restores the default action mappings for the current mode."/>
            <panel
                name="action_mappings_panel"
                layout="topleft"
                follows="all"
                top="82"
                left="1"
                right="-1"
                bottom="-1">
                <panel
                    name="action_mappings_axes_panel"
                    layout="topleft"
                    follows="top|left|right"
                    top="1"
                    left="1"
                    right="-1"
                    height="146">
                    <scroll_list
                        name="action_mappings_axes"
                        follows="all"
                        top="1"
                        left="1"
                        right="-1"
                        bottom="-1"
                        can_sort="false"
                        column_padding="0"
                        draw_heading="true"
                        multi_select="false"
                        selection_type="header"
                        fg_disable_color="ScrollUnselectedColor">
                        <scroll_list.columns name="action" label="Action" relative_width="0.40"/>
                        <scroll_list.columns name="input" label="Input" relative_width="0.20"/>
                        <scroll_list.columns name="input_description" label="Axis" relative_width="0.40"/>
                    </scroll_list>
                </panel>
                <panel
                    name="action_mappings_buttons_panel"
                    layout="topleft"
                    follows="all"
                    top="143"
                    left="1"
                    right="-1"
                    bottom="-1">
                    <scroll_list
                        name="action_mappings_buttons"
                        follows="all"
                        top="1"
                        left="1"
                        right="-1"
                        bottom="-1"
                        can_sort="false"
                        column_padding="0"
                        draw_heading="true"
                        multi_select="false"
                        selection_type="header"
                        fg_disable_color="ScrollUnselectedColor">
                        <scroll_list.columns name="action" label="Action" relative_width="0.40"/>
                        <scroll_list.columns name="input" label="Input" relative_width="0.20"/>
                        <scroll_list.columns name="input_description" label="Button" relative_width="0.40"/>
                    </scroll_list>
                </panel>
            </panel>
        </panel>
        <!-- DEVICES: per-device.  Normalizes physical hardware to canonical inputs. -->
        <panel
            name="tab_device_mappings"
            label="Device Mappings">
            <text
                type="string"
                name="nodevice_message"
                layout="topleft"
                follows="all"
                halign="center"
                valign="center"
                top="26"
                left="1"
                right="-1"
                bottom="-1">No device</text>
            <check_box
                name="show_all_known_devices"
                label="Show all known devices"
                layout="topleft"
                follows="top|left"
                top="38"
                left="61"
                height="16"
                width="160"/>
            <text
                type="string"
                name="device_prompt"
                layout="topleft"
                follows="top|left"
                valign="center"
                top="10"
                left="9"
                height="23"
                width="48">Device:</text>
            <combo_box
                name="device_list"
                layout="topleft"
                follows="top|left"
                top="10"
                left="61"
                height="23"
                width="260"/>
            <button
                name="restore_device_defaults"
                layout="topleft"
                follows="top|right"
                top="10"
                right="-8"
                height="23"
                width="140"
                label="Restore Defaults"
                tool_tip="Restores default settings for the selected device."/>
            <panel
                name="device_settings"
                layout="topleft"
                follows="all"
                top="66"
                left="1"
                right="-1"
                bottom="-2">
                <panel
                    name="axis_channels_panel"
                    layout="topleft"
                    follows="top|left|right"
                    top="1"
                    left="1"
                    right="-1"
                    height="146">
                    <scroll_list
                        name="axis_channels"
                        follows="all"
                        top="1"
                        left="1"
                        right="-1"
                        bottom="-1"
                        can_sort="false"
                        column_padding="0"
                        draw_heading="true"
                        multi_select="false"
                        selection_type="header"
                        fg_disable_color="ScrollUnselectedColor">
                        <scroll_list.columns name="input"              label=""              relative_width="0.15"/>
                        <scroll_list.columns name="input_description"  label="What you press" relative_width="0.35"/>
                        <scroll_list.columns name="output_description" label="What you get"   relative_width="0.35"/>
                        <scroll_list.columns name="output"             label=""              relative_width="0.15"/>
                    </scroll_list>
                </panel>
                <panel
                    name="button_channels_panel"
                    layout="topleft"
                    follows="all"
                    top="143"
                    left="1"
                    right="-1"
                    bottom="-1">
                    <scroll_list
                        name="button_channels"
                        follows="all"
                        top="1"
                        left="1"
                        right="-1"
                        bottom="-1"
                        can_sort="false"
                        column_padding="0"
                        draw_heading="true"
                        multi_select="false"
                        selection_type="header"
                        fg_disable_color="ScrollUnselectedColor">
                        <scroll_list.columns name="input"              label=""              relative_width="0.15"/>
                        <scroll_list.columns name="input_description"  label="What you press" relative_width="0.35"/>
                        <scroll_list.columns name="output_description" label="What you get"   relative_width="0.35"/>
                        <scroll_list.columns name="output"             label=""              relative_width="0.15"/>
                    </scroll_list>
                </panel>
            </panel>
        </panel>
        <!-- DEVICE STATE: live, read-only view of the raw input from the selected device. -->
        <panel
            name="tab_device_options"
            label="Device Options">
            <text
                type="string"
                name="state_nodevice_message"
                layout="topleft"
                follows="all"
                halign="center"
                valign="center"
                top="26"
                left="1"
                right="-1"
                bottom="-1">No device</text>
            <text
                type="string"
                name="state_device_prompt"
                layout="topleft"
                follows="top|left"
                valign="center"
                top="10"
                left="9"
                height="23"
                width="48">Device:</text>
            <combo_box
                name="options_device_list"
                layout="topleft"
                follows="top|left"
                top="10"
                left="61"
                height="23"
                width="260"/>
            <button
                name="restore_device_options_defaults"
                layout="topleft"
                follows="top|right"
                top="10"
                right="-8"
                height="23"
                width="140"
                label="Restore Defaults"
                tool_tip="Restores the default Offset, Invert, and Dead Zone for every axis of the selected device."/>
            <panel
                name="device_state_settings"
                layout="topleft"
                follows="all"
                top="38"
                left="1"
                right="-1"
                bottom="-2">
                <panel
                    name="axis_state_panel"
                    layout="topleft"
                    follows="top|left|right"
                    top="1"
                    left="1"
                    right="-1"
                    height="146">
                    <scroll_list
                        name="axis_state"
                        follows="all"
                        top="1"
                        left="1"
                        right="-1"
                        bottom="-1"
                        can_sort="false"
                        column_padding="0"
                        draw_heading="true"
                        multi_select="false"
                        selection_type="header"
                        fg_disable_color="ScrollUnselectedColor">
                        <scroll_list.columns name="input_glyph" label="Input"          relative_width="0.12"/>
                        <scroll_list.columns name="input"       label="Axis"           relative_width="0.18"/>
                        <scroll_list.columns name="raw_value"   label="Raw Value"      relative_width="0.14"/>
                        <scroll_list.columns name="offset"      label="Offset"         relative_width="0.10"/>
                        <scroll_list.columns name="invert"      label="Invert"         type="checkbox" relative_width="0.10"/>
                        <scroll_list.columns name="dead_zone"   label="Dead Zone"      relative_width="0.15"/>
                        <scroll_list.columns name="fixed_value" label="Adjusted Value" relative_width="0.21"/>
                    </scroll_list>
                </panel>
                <panel
                    name="button_state_panel"
                    layout="topleft"
                    follows="all"
                    top="143"
                    left="1"
                    right="-1"
                    bottom="-1">
                    <scroll_list
                        name="button_state"
                        follows="all"
                        top="1"
                        left="1"
                        right="-1"
                        bottom="-1"
                        can_sort="false"
                        column_padding="0"
                        draw_heading="true"
                        multi_select="false"
                        selection_type="header"
                        fg_disable_color="ScrollUnselectedColor">
                        <scroll_list.columns name="input_glyph" label="Input"  relative_width="0.15"/>
                        <scroll_list.columns name="input"       label="Button" relative_width="0.45"/>
                        <scroll_list.columns name="value"       label="Value"  relative_width="0.40"/>
                    </scroll_list>
                </panel>
            </panel>
        </panel>
        <!-- DATA OUTPUT: live, read-only view of the channel values packed into the
             most recent outgoing GameControlInput message. -->
        <panel
            name="tab_server_data"
            label="Server Data">
            <text
                type="string"
                name="data_note"
                layout="topleft"
                follows="top|left|right"
                word_wrap="true"
                top="8"
                left="9"
                right="-9"
                height="28">Data sent to the server:</text>
            <panel
                name="data_panel"
                layout="topleft"
                follows="all"
                top="30"
                left="1"
                right="-1"
                bottom="-1">
                <scroll_list
                    name="data_output"
                    follows="all"
                    top="1"
                    left="1"
                    right="-1"
                    bottom="-1"
                    can_sort="false"
                    column_padding="0"
                    draw_heading="true"
                    multi_select="false"
                    selection_type="header"
                    fg_disable_color="ScrollUnselectedColor">
                    <scroll_list.columns name="index"  label="#"      relative_width="0.1"/>
                    <scroll_list.columns name="output" label="Name"   relative_width="0.5"/>
                    <scroll_list.columns name="value"  label="Value"  relative_width="0.4"/>
                </scroll_list>
            </panel>
        </panel>
    </tab_container>
    <spinner
        name="numeric_value_editor"
        decimal_digits="0"
        increment="1"
        width="100"
        height="18"/>
    <!-- axis_input_selector: the canonical axis INPUTS an axis action can be bound
         to on the Actions tab.  The two triggers are offered only as the combined
         "Triggers ↔" pair (value AXIS_TRIGGERS): each trigger is positive-
         only, so the pair is treated as one bidirectional axis (left trigger drives
         the negative direction, right trigger the positive).  See the trigger-pair
         handling in llgamecontrol.cpp (rebuildActionLookup / avatarAxisBridge). -->
    <combo_box
        name="axis_input_selector"
        width="200"
        height="18">
        <combo_box.item
            label="L Stick ↔"
            name="axis_leftx"
            value="AXIS_LEFTX"/>
        <combo_box.item
            label="L Stick ↕"
            name="axis_lefty"
            value="AXIS_LEFTY"/>
        <combo_box.item
            label="R Stick ↔"
            name="axis_rightx"
            value="AXIS_RIGHTX"/>
        <combo_box.item
            label="R Stick ↕"
            name="axis_righty"
            value="AXIS_RIGHTY"/>
        <combo_box.item
            label="Triggers ↘↙"
            name="axis_triggers"
            value="AXIS_TRIGGERS"/>
        <combo_box.item
            label="None"
            name="axis_none"
            value="AXIS_NONE"/>
    </combo_box>
    <!-- axis_input_glyph_selector: the glyph counterpart of axis_input_selector,
         shown when editing the PromptFont "Axis" (icon) column.  Items are built
         in C++ from axis_input_selector's values so the value list stays in one
         place; each item's label is the PromptFont glyph for that axis. -->
    <combo_box
        name="axis_input_glyph_selector"
        width="200"
        height="18"/>
    <!-- axis_output_selector: the canonical axis a physical device axis maps to on
         the Devices tab.  This is strictly index-based (item N == canonical axis N,
         matching LLGameControl::KeyboardAxis; the final "None" item == NUM_AXES), so
         it lists every individual canonical axis, including each trigger separately. -->
    <combo_box
        name="axis_output_selector"
        width="200"
        height="18">
        <combo_box.item
            label="L Stick ↔"
            name="axis_0"
            value="AXIS_LEFTX"/>
        <combo_box.item
            label="L Stick ↕"
            name="axis_1"
            value="AXIS_LEFTY"/>
        <combo_box.item
            label="R Stick ↔"
            name="axis_2"
            value="AXIS_RIGHTX"/>
        <combo_box.item
            label="R Stick ↕"
            name="axis_3"
            value="AXIS_RIGHTY"/>
        <combo_box.item
            label="L Trigger ↘"
            name="axis_4"
            value="AXIS_LEFT_TRIGGER"/>
        <combo_box.item
            label="R Trigger ↙"
            name="axis_5"
            value="AXIS_RIGHT_TRIGGER"/>
        <combo_box.item
            label="Triggers ↘↙"
            name="axis_output_triggers"
            value="AXIS_TRIGGERS"/>
        <combo_box.item
            label="None"
            name="axis_none"
            value="AXIS_NONE"/>
    </combo_box>
    <!-- axis_output_glyph_selector: the glyph counterpart of axis_output_selector,
