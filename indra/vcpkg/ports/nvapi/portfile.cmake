vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO NVIDIA/nvapi
    REF 3d34a4faf095996663321646ebe003539a908f89
    SHA512 56a4633cbdf388448397ae6482d6bce32644119bc809b709f019dad62dbfce95c83edb0f2a2c577431fe5f6b1cc89330550a27b0a8b74d3d835b53b46ce869c0
    HEAD_REF main
)

file(INSTALL
    DIRECTORY "${SOURCE_PATH}/"
    DESTINATION "${CURRENT_PACKAGES_DIR}/include/nvapi"
    FILES_MATCHING
    PATTERN "*.c"
    PATTERN "*.h"
    PATTERN "amd64" EXCLUDE
    PATTERN "docs" EXCLUDE
    PATTERN "Sample_Code" EXCLUDE
    PATTERN "x86" EXCLUDE
)

file(INSTALL "${SOURCE_PATH}/amd64/nvapi64.lib" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")

file(INSTALL "${SOURCE_PATH}/License.txt" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}" RENAME copyright)
